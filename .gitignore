# --- LinRAR ---------------------------------------------------------------
# The virtual environment install.sh builds, and the record of what it put on
# the system.  Both are per-machine; never commit them.
.venv/
venv/
.install-manifest
.install-manifest.tmp
.install-receipt

# The build stamp tools/package.sh writes into a release artifact (commit,
# date, tag).  It says "this copy was published"; a working tree never was, so
# committing it would make every clone claim to be a release.
linrar/_build.py
linrar/_files.txt

# The themes folder, and everything in it including its README.
#
# This is the user's folder, not the project's: they drop themes into it, edit
# them and delete them, and nothing shipped lives there -- the format is
# documented in docs/THEMES.md instead of in a file sitting among their themes.
# A checked-in copy would fight with whatever they put there.
#
# The ten themes LinRAR comes with are generated by tools/make_themes.py, which
# *is* committed: run it to get them back.  They are also downloadable from
# linrar-ui's /themes page.
/themes/
/themes/**
/themes/README.md
*.linrar-theme

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- editors and desktops -------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# The demo folder tools/screenshots.py builds and deletes.  Ignored so an
# interrupted run cannot leave it staged.
/screenshot-demo/

# --- scratch --------------------------------------------------------------
# Archives and extraction output left behind by a manual test run.
/tmp/
*.log
*.rar
*.zip
*.7z
*.sfx
*.AppImage
!docs/**/*.png
