# --- LinRAR ---------------------------------------------------------------
# The virtual environment install.sh builds, and the record of what it put on
# the system.  Both are per-machine; never commit them.
.venv/
venv/
.install-manifest
.install-manifest.tmp
.install-receipt

# The build stamp tools/package.sh writes into a release artifact (commit,
# date, tag).  It says "this copy was published"; a working tree never was, so
# committing it would make every clone claim to be a release.
linrar/_build.py
linrar/_files.txt

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- editors and desktops -------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- scratch --------------------------------------------------------------
# Archives and extraction output left behind by a manual test run.
/tmp/
*.log
*.rar
*.zip
*.7z
*.sfx
*.AppImage
!docs/**/*.png
